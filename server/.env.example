# Copy this file to server/.env and fill in the secrets:
#   cp server/.env.example server/.env

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
# Path relative to the server/ folder. Use :memory: for an in-memory database (tests).
SQLITE_DB_PATH=./src/database/expense_tracker.db

# JWT Configuration
# Generate a value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-too

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads/receipts

# CORS Configuration
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
